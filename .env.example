# Copy to .env and adjust. Values shown are dev defaults.
PORT=4747
DATABASE_URL=postgres://postgres@127.0.0.1:5434/yabil-timekeep
JWT_SECRET=change-me-in-prod
ORG_ENCRYPTION_KEY=change-me-32-bytes-minimum
CORS_ORIGINS=https://timekeep.salmaan.dev,https://yabil-timekeep.salmaan.dev,https://faceattendance.salmaan.dev,http://127.0.0.1:4750,http://localhost:4750

# AWS Rekognition face check-in.
# af-south-1 is not supported; sa-east-1 (São Paulo) is the closest supported
# region. Store the access keys in the hermes secret store, not in Git.
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_COLLECTION_PREFIX=yabil-timekeep
REKOGNITION_SIMILARITY_THRESHOLD=90
REKOGNITION_AMBIGUITY_MARGIN=2

# Optional. The kiosk auto-update check reads the public GitHub releases API;
# a token only raises the unauthenticated 60 requests/hour limit.
GITHUB_TOKEN=
